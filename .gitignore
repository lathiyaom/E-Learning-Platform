# Root .gitignore for monorepo

# Node modules at root (if any)
node_modules/

# Ignore install logs
npm-debug.log*
yarn-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/

# Environment files
.env
.env.*

# Build output
/dist
/build

# Specific subprojects
/Backend/node_modules/
/Frontend/node_modules/
/Frontend/build/

# Coverage
/Backend/coverage
/Frontend/coverage
